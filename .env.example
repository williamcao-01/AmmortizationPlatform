# Copy this file to .env and put the credential only in the local .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
KNOWLEDGE_CHAT_ALLOW_EXTERNAL=false
DEEPSEEK_TIMEOUT_SECONDS=45

# Neo4j Community is required for the Ontology and agent-evidence read model.
# The service fails fast unless this is true and the connection details are valid.
NEO4J_ENABLED=true
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
